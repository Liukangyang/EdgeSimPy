{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Python: 当前文件(PYTHONPATH)",
      "type": "debugpy",
      "request": "launch",
      "program": "${file}",
      "console": "integratedTerminal",
      "env": {
        "PYTHONPATH": "${workspaceFolder}"  // 关键：加入项目根目录
      }
    }
  ]
}